# Copia este archivo como .env para probar en tu ordenador.
# En Render NO subes este archivo: pones estas mismas variables en "Environment".

# ── Supabase (Project Settings → API Keys) ──
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# La clave SECRETA (sb_secret_... o la antigua "service_role"). ¡Nunca la pongas en el navegador!
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxxxxxx

# ── PINs de acceso (pon los que quieras, mejor de 6+ cifras) ──
TAQUILLA_PIN=482913
PORTERO_PIN=730215

# ── Datos de la fiesta (salen en el email y en la entrada) ──
EVENTO_NOMBRE=Fiesta de Fin de Año
EVENTO_FECHA=Sábado 31 dic · 23:30
EVENTO_LUGAR=Sala Ejemplo, Granada

# ── Email: rellena UNO de los dos (Brevo es el más fácil sin dominio) ──
BREVO_API_KEY=
RESEND_API_KEY=
# Remitente: con Brevo, el email que verificaste; con Resend, uno de tu dominio verificado.
EMAIL_FROM=tucorreo@gmail.com
EMAIL_FROM_NAME=Fiesta de Fin de Año

# ── URL pública (en Render se detecta sola; ponla si usas dominio propio) ──
# PUBLIC_URL=https://entradas.tudominio.com
